{
    "name": "react-native-gpui",
    "version": "0.1.39",
    "private": true,
    "scripts": {
        "demo": "cd rust && cargo run --release --bin rngpui-demo",
        "demo:debug": "cd rust && cargo run --bin rngpui-demo",
        "demo:ts": "cd ts && bun run src/demo.tsx",
        "demo:ts:debug": "cd rust && cargo build --bin rngpui-service && cd ../ts && bun run src/demo.tsx",
        "release": "semantic-release",
        "release:dry-run": "semantic-release --dry-run"
    },
    "devDependencies": {
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/github": "^12.0.9",
        "@semantic-release/npm": "^13.1.5",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "conventional-changelog-conventionalcommits": "^10.2.1",
        "semantic-release": "^25.0.5"
    }
}
